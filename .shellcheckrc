# Конфигурация shellcheck. Лежит в корне, поэтому подхватывается и локальным
# запуском, и CI - раньше они расходились: CI звал shellcheck с
# --external-sources, а локальный запуск без него, и выдача отличалась
# полусотней предупреждений.

# Следовать за source/. в подключаемые файлы. Без этого shellcheck не видит,
# что переменные из lib/paths.sh используются в bin/*, и выдаёт три десятка
# ложных SC2034 "appears unused".
external-sources=true

# Пути, относительно которых искать подключаемые файлы. Скрипты в bin/
# подключают их как "$ZDY_LIB/common.sh", где ZDY_LIB вычисляется в рантайме,
# поэтому статически путь не выводится.
source-path=SCRIPTDIR
source-path=SCRIPTDIR/lib
source-path=SCRIPTDIR/../lib
